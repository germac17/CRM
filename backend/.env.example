PORT=4000
NODE_ENV=development

# Данные хранятся в backend/data/ (JSON). При деплое можно подключить PostgreSQL.

# Один хост: URL приложения (CORS, редирект после верификации)
APP_URL=http://localhost:3000
# URL backend (для ссылки в письме верификации; на одном хосте = APP_URL)
BACKEND_URL=http://localhost:4000

# AI-матчинг (опционально; если не задан — матчинг возвращает 503)
AI_SERVICE_URL=

# Флаги
FEATURE_EMAIL_VERIFICATION=false
FEATURE_TARIFFS=false

# Письма (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Naymi HR
